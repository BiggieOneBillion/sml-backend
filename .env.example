# ─────────────────────────────────────────────────────────────────────────────
# SML Stock Market API — Environment Configuration
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_VERSION=v1
APP_NAME="SML Stock Market API"
FRONTEND_URL=http://localhost:3001

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL=postgresql://sml:sml_dev_password@localhost:5432/sml_db?schema=public

# ── JWT Authentication ────────────────────────────────────────────────────────
# MUST be at least 32 characters. Use: openssl rand -base64 48
JWT_ACCESS_SECRET=REPLACE_ME_with_min_32_char_random_string_access
JWT_REFRESH_SECRET=REPLACE_ME_with_min_32_char_random_string_refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=your_redis_password
REDIS_TLS=false

# ── AWS / Storage ─────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
S3_BUCKET_PUBLIC=sml-public-assets-dev
S3_BUCKET_PRIVATE=sml-private-documents-dev
# CLOUDFRONT_URL=https://your-distribution.cloudfront.net

# ── Stripe ────────────────────────────────────────────────────────────────────
# Use TEST keys in development (sk_test_..., whsec_...)
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_INVESTOR_PRICE_ID=price_REPLACE_ME

# ── Email (Resend) ────────────────────────────────────────────────────────────
# RESEND_API_KEY=re_REPLACE_ME
EMAIL_FROM=noreply@smlstockmarket.com

# ── SMS / 2FA (Twilio) ────────────────────────────────────────────────────────
# TWILIO_ACCOUNT_SID=ACxxx
# TWILIO_AUTH_TOKEN=xxx
# TWILIO_VERIFY_SERVICE_SID=VAxx

# ── Rate Limiting ─────────────────────────────────────────────────────────────
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# ── Security ──────────────────────────────────────────────────────────────────
# Lower bcrypt rounds in dev for speed (10-12 recommended, 12 in production)
BCRYPT_ROUNDS=10
# MUST be at least 32 characters
COOKIE_SECRET=REPLACE_ME_with_min_32_char_random_string_cookie
